# Image de base legere
FROM alpine:latest

# Installation de Nginx + creation des dossiers necessaires
RUN apk add --no-cache nginx && \
    mkdir -p /run/nginx /var/www/localhost/htdocs

# Page HTML de preuve de deploiement
RUN echo "<h1>Application Deployed via Terraform IaC!</h1>" > /var/www/localhost/htdocs/index.html

# Config Nginx : servir la page sur le port 80 (la config Alpine par defaut renvoie 404)
RUN printf 'server {\n    listen 80 default_server;\n    root /var/www/localhost/htdocs;\n    index index.html;\n    location / {\n        try_files $uri $uri/ =404;\n    }\n}\n' > /etc/nginx/http.d/default.conf

EXPOSE 80

# Nginx au premier plan pour que le conteneur reste actif
CMD ["nginx", "-g", "daemon off;"]
